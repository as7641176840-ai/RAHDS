<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#d9534f">
    <title>Jaipur Rush 3D - Pink City Drive</title>
    <link rel="manifest" href="manifest.json">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-user-select: none; }
        body, html { width: 100%; height: 100%; overflow: hidden; background: #1a1a1a; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        canvas { display: block; width: 100%; height: 100%; }

        /* HUD (Heads-Up Display) */
        #hud {
            position: absolute; top: 15px; left: 15px; right: 15px;
            display: flex; justify-content: space-between; align-items: flex-start;
            pointer-events: none; z-index: 10; color: white;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
        }
        .stats-box {
            background: rgba(0, 0, 0, 0.6); padding: 10px 15px; border-radius: 12px;
            border-left: 4px solid #ff9933; backdrop-filter: blur(4px);
        }
        .stats-box div { font-size: 16px; font-weight: bold; margin-bottom: 4px; }
        .coin-text { color: #ffd700; }
        
        /* Mission Box */
        #mission-box {
            background: rgba(217, 83, 79, 0.85); padding: 10px 15px; border-radius: 12px;
            border: 2px solid #ffd700; max-width: 240px; text-align: right;
        }
        #mission-title { font-size: 12px; text-transform: uppercase; color: #ffd700; letter-spacing: 1px; }
        #mission-desc { font-size: 14px; font-weight: bold; margin-top: 3px; }
        #mission-progress { font-size: 13px; margin-top: 4px; color: #fff; }

        /* Speedometer */
        #speedo {
            position: absolute; bottom: 130px; right: 20px;
            background: rgba(0,0,0,0.7); color: #00ffcc; padding: 8px 14px;
            border-radius: 20px; font-weight: bold; font-size: 18px;
            border: 2px solid #00ffcc; pointer-events: none; z-index: 10;
        }

        /* Mobile Touch Controls */
        #controls {
            position: absolute; bottom: 20px; left: 20px; right: 20px;
            display: flex; justify-content: space-between; align-items: flex-end;
            z-index: 20; pointer-events: none;
        }
        .control-group { display: flex; gap: 15px; pointer-events: auto; }
        .btn {
            width: 70px; height: 70px; border-radius: 50%;
            background: rgba(255, 255, 255, 0.2); border: 2px solid rgba(255, 255, 255, 0.6);
            color: white; font-size: 24px; font-weight: bold;
            display: flex; justify-content: center; align-items: center;
            backdrop-filter: blur(5px); touch-action: manipulation;
        }
        .btn:active, .btn.active { background: rgba(255, 153, 51, 0.7); transform: scale(0.92); }
        .btn-pedal { width: 65px; height: 95px; border-radius: 16px; font-size: 16px; }
        .btn-brake { background: rgba(220, 53, 69, 0.35); border-color: #ff4d4d; }
        .btn-gas { background: rgba(40, 167, 69, 0.35); border-color: #28a745; }

        /* Start & Game Over Screens */
        .overlay {
            position: absolute; inset: 0; background: rgba(20, 10, 15, 0.88);
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            color: white; z-index: 30; text-align: center; padding: 20px;
        }
        .overlay h1 {
            font-size: 38px; color: #ff7b7b; text-shadow: 0 4px 10px rgba(255, 100, 100, 0.5);
            margin-bottom: 10px;
        }
        .overlay p { font-size: 16px; color: #ddd; max-width: 400px; margin-bottom: 25px; line-height: 1.5; }
        .start-btn {
            padding: 15px 40px; font-size: 20px; font-weight: bold; color: #fff;
            background: linear-gradient(45deg, #d9534f, #ff9933); border: none;
            border-radius: 30px; cursor: pointer; box-shadow: 0 5px 15px rgba(217, 83, 79, 0.5);
        }
        .start-btn:active { transform: scale(0.95); }
        .hidden { display: none !important; }
    </style>
</head>
<body>

    <!-- HUD -->
    <div id="hud">
        <div class="stats-box">
            <div>स्कोर: <span id="score">0</span></div>
            <div class="coin-text">🪙 सिक्के: <span id="coins">0</span></div>
            <div style="font-size: 12px; color: #aaa;">हाई स्कोर: <span id="highScore">0</span></div>
        </div>
        <div id="mission-box">
            <div id="mission-title">मिशन #1</div>
            <div id="mission-desc">10 सिक्के इकट्ठा करें</div>
            <div id="mission-progress">प्रगति: 0 / 10</div>
        </div>
    </div>

    <div id="speedo"><span id="speed-val">0</span> KM/H</div>

    <!-- Mobile Controls -->
    <div id="controls">
        <div class="control-group">
            <div class="btn" id="btn-left">◀</div>
            <div class="btn" id="btn-right">▶</div>
        </div>
        <div class="control-group">
            <div class="btn btn-pedal btn-brake" id="btn-brake">ब्रेक</div>
            <div class="btn btn-pedal btn-gas" id="btn-gas">रेस</div>
        </div>
    </div>

    <!-- Start Screen -->
    <div id="start-screen" class="overlay">
        <h1>🏰 जयपुर रश (Jaipur Rush)</h1>
        <p>गुलाबी शहर की सड़कों पर रफ़्तार का मज़ा लें! ऑटो-रिक्शा और बसों से बचें, सिक्के जमा करें और मिशन पूरे करें।</p>
        <button class="start-btn" onclick="startGame()">ड्राइव शुरू करें</button>
    </div>

    <!-- Game Over Screen -->
    <div id="gameover-screen" class="overlay hidden">
        <h1 style="color: #ff4d4d;">एक्सीडेंट हो गया! 💥</h1>
        <p id="final-stats">आपका स्कोर: 0 | सिक्के: 0</p>
        <button class="start-btn" onclick="startGame()">फिर से खेलें</button>
    </div>

    <canvas id="gameCanvas"></canvas>

    <script>
        // PWA Service Worker Registration
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('sw.js').catch(err => console.log('SW Error:', err));
        }

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        // Audio Engine (Synthesizer for Engine & Coin Sound - No external files needed)
        let audioCtx;
        function initAudio() {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        function playSound(type) {
            if (!audioCtx) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (type === 'coin') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(880, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(1320, audioCtx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
                osc.start(); osc.stop(audioCtx.currentTime + 0.1);
            } else if (type === 'crash') {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(120, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(30, audioCtx.currentTime + 0.4);
                gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
                osc.start(); osc.stop(audioCtx.currentTime + 0.4);
            } else if (type === 'mission') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(523.25, audioCtx.currentTime);
                osc.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.1);
                osc.frequency.setValueAtTime(783.99, audioCtx.currentTime + 0.2);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.4);
                osc.start(); osc.stop(audioCtx.currentTime + 0.4);
            }
        }

        // Responsive Canvas
        let width, height, roadWidth, roadLeft, roadRight;
        function resize() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
            roadWidth = Math.min(width * 0.65, 420);
            roadLeft = (width - roadWidth) / 2;
            roadRight = roadLeft + roadWidth;
        }
        window.addEventListener('resize', resize);
        resize();

        // Game State
        let isRunning = false;
        let score = 0;
        let coins = 0;
        let highScore = localStorage.getItem('jaipurHighScore') || 0;
        document.getElementById('highScore').innerText = highScore;

        // Controls State
        const keys = { left: false, right: false, up: false, down: false };

        // Player Car (Realistic Physics Properties)
        const car = {
            x: 0, y: 0, width: 38, height: 68,
            speed: 0, maxSpeed: 16, accel: 0.25, friction: 0.08, brakeForce: 0.45,
            vx: 0, angle: 0
        };

        // Entities
        let traffic = [];
        let coinList = [];
        let buildings = [];
        let skidMarks = [];
        let roadOffset = 0;

        // Mission System
        const missions = [
            { id: 1, type: 'coins', target: 10, desc: '10 सिक्के इकट्ठा करें', reward: 500 },
            { id: 2, type: 'score', target: 1500, desc: '1500 स्कोर बनाएं', reward: 800 },
            { id: 3, type: 'overtake', target: 15, desc: '15 गाड़ियों को ओवरटेक करें', reward: 1000 },
            { id: 4, type: 'coins', target: 30, desc: 'कुल 30 सिक्के जमा करें', reward: 1500 }
        ];
        let currentMissionIdx = 0;
        let missionProgress = 0;
        let overtakes = 0;

        function updateMissionUI() {
            const m = missions[currentMissionIdx % missions.length];
            document.getElementById('mission-title').innerText = `मिशन #${currentMissionIdx + 1}`;
            document.getElementById('mission-desc').innerText = m.desc;
            
            if (m.type === 'coins') missionProgress = coins;
            if (m.type === 'score') missionProgress = Math.floor(score);
            if (m.type === 'overtake') missionProgress = overtakes;

            document.getElementById('mission-progress').innerText = `प्रगति: ${Math.min(missionProgress, m.target)} / ${m.target}`;

            if (missionProgress >= m.target) {
                score += m.reward;
                playSound('mission');
                currentMissionIdx++;
                updateMissionUI();
            }
        }

        // Generate Jaipur Pink City Architecture on sides
        function initBuildings() {
            buildings = [];
            for (let y = -200; y < height + 200; y += 160) {
                buildings.push({ y, side: 'left', h: 140, windows: Math.floor(Math.random() * 3) + 2 });
                buildings.push({ y: y + 40, side: 'right', h: 140, windows: Math.floor(Math.random() * 3) + 2 });
            }
        }

        function startGame() {
            initAudio();
            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('gameover-screen').classList.add('hidden');
            
            car.x = width / 2;
            car.y = height - 160;
            car.speed = 4;
            car.vx = 0;
            car.angle = 0;

            score = 0;
            coins = 0;
            overtakes = 0;
            currentMissionIdx = 0;
            traffic = [];
            coinList = [];
            skidMarks = [];
            initBuildings();
            updateMissionUI();
            isRunning = true;
            requestAnimationFrame(gameLoop);
        }

        // Spawn Traffic (Jaipur Auto-Rickshaws, Cars, Buses)
        function spawnTraffic() {
            if (Math.random() < 0.025 + (score * 0.000005)) {
                const lanes = 3;
                const laneWidth = roadWidth / lanes;
                const lane = Math.floor(Math.random() * lanes);
                const x = roadLeft + lane * laneWidth + laneWidth / 2;

                // Prevent overlapping spawns
                if (traffic.some(t => Math.abs(t.y - (-100)) < 140 && Math.abs(t.x - x) < 40)) return;

                const types = [
                    { name: 'auto', w: 30, h: 48, color: '#2ecc71', topColor: '#f1c40f', speed: 3.5 }, // Green-Yellow Auto
                    { name: 'car', w: 36, h: 64, color: '#3498db', topColor: '#2980b9', speed: 5 },    // Sedan
                    { name: 'bus', w: 44, h: 95, color: '#e67e22', topColor: '#d35400', speed: 3 }     // Rajasthan Roadways style
                ];
                const type = types[Math.floor(Math.random() * types.length)];
                traffic.push({ x, y: -100, ...type, passed: false });
            }
        }

        // Spawn Coins
        function spawnCoins() {
            if (Math.random() < 0.03) {
                const x = roadLeft + 30 + Math.random() * (roadWidth - 60);
                coinList.push({ x, y: -50, radius: 12, angle: 0 });
            }
        }

        // Drawing Functions
        function drawJaipurEnvironment() {
            // Sand / Footpath background
            ctx.fillStyle = '#d2b48c';
            ctx.fillRect(0, 0, width, height);

            // Road Base
            ctx.fillStyle = '#2c3e50';
            ctx.fillRect(roadLeft, 0, roadWidth, height);

            // Red & White Jaipur Kerb Borders
            const kerbHeight = 40;
            for (let y = (roadOffset % (kerbHeight * 2)) - kerbHeight * 2; y < height; y += kerbHeight) {
                ctx.fillStyle = (Math.floor((y - roadOffset) / kerbHeight) % 2 === 0) ? '#c0392b' : '#ecf0f1';
                ctx.fillRect(roadLeft - 12, y, 12, kerbHeight);
                ctx.fillRect(roadRight, y, 12, kerbHeight);
            }

            // Lane Dividers
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.6)';
            ctx.lineWidth = 4;
            ctx.setLineDash([30, 30]);
            ctx.lineDashOffset = -roadOffset;
            for (let i = 1; i < 3; i++) {
                const lx = roadLeft + (roadWidth / 3) * i;
                ctx.beginPath();
                ctx.moveTo(lx, 0);
                ctx.lineTo(lx, height);
                ctx.stroke();
            }
            ctx.setLineDash([]);

            // Pink City Hawa-Mahal Inspired Buildings on Sides
            buildings.forEach(b => {
                b.y += car.speed;
                if (b.y > height + 50) b.y = -160;

                const bw = roadLeft - 20;
                if (bw < 25) return; // Skip on very narrow screens
                const bx = b.side === 'left' ? 5 : roadRight + 15;

                // Terracotta Pink Wall
                ctx.fillStyle = '#d96b66';
                ctx.fillRect(bx, b.y, bw, b.h);
                ctx.strokeStyle = '#fff3e6';
                ctx.lineWidth = 2;
                ctx.strokeRect(bx + 3, b.y + 3, bw - 6, b.h - 6);

                // Jharokha (Arched Windows)
                ctx.fillStyle = '#4a1c1a';
                for (let w = 0; w < b.windows; w++) {
                    const wy = b.y + 20 + w * 40;
                    ctx.beginPath();
                    ctx.arc(bx + bw / 2, wy, 10, Math.PI, 0);
                    ctx.lineTo(bx + bw / 2 + 10, wy + 15);
                    ctx.lineTo(bx + bw / 2 - 10, wy + 15);
                    ctx.fill();
                }
            });
        }

        function drawCar(x, y, w, h, color, roofColor, angle = 0, isPlayer = false) {
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(angle);

            // Shadow
            ctx.fillStyle = 'rgba(0,0,0,0.4)';
            ctx.fillRect(-w / 2 + 5, -h / 2 + 6, w, h);

            // Body
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.roundRect(-w / 2, -h / 2, w, h, 8);
            ctx.fill();

            // Windshield & Roof
            ctx.fillStyle = '#1a252f';
            ctx.fillRect(-w / 2 + 4, -h / 2 + 12, w - 8, h - 24);
            ctx.fillStyle = roofColor;
            ctx.fillRect(-w / 2 + 5, -h / 2 + 20, w - 10, h - 38);

            // Headlights
            ctx.fillStyle = '#fff9c4';
            ctx.fillRect(-w / 2 + 4, -h / 2, 7, 4);
            ctx.fillRect(w / 2 - 11, -h / 2, 7, 4);

            // Headlight Beams for Player
            if (isPlayer) {
                const grad = ctx.createLinearGradient(0, -h / 2, 0, -h / 2 - 120);
                grad.addColorStop(0, 'rgba(255, 255, 200, 0.35)');
                grad.addColorStop(1, 'rgba(255, 255, 200, 0)');
                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.moveTo(-w / 2 + 4, -h / 2);
                ctx.lineTo(-w - 15, -h / 2 - 120);
                ctx.lineTo(w + 15, -h / 2 - 120);
                ctx.lineTo(w / 2 - 4, -h / 2);
                ctx.fill();

                // Brake Lights
                if (keys.down) {
                    ctx.fillStyle = '#ff0000';
                    ctx.shadowColor = '#ff0000';
                    ctx.shadowBlur = 10;
                    ctx.fillRect(-w / 2 + 3, h / 2 - 3, 9, 4);
                    ctx.fillRect(w / 2 - 12, h / 2 - 3, 9, 4);
                    ctx.shadowBlur = 0;
                }
            }

            ctx.restore();
        }

        function updatePhysics() {
            // Acceleration & Braking
            if (keys.up) {
                car.speed = Math.min(car.maxSpeed, car.speed + car.accel);
            } else if (keys.down) {
                car.speed = Math.max(0, car.speed - car.brakeForce);
                if (car.speed > 3) {
                    skidMarks.push({ x: car.x - 12, y: car.y + 25, alpha: 0.6 });
                    skidMarks.push({ x: car.x + 12, y: car.y + 25, alpha: 0.6 });
                }
            } else {
                // Natural coasting friction (keeps minimum cruise speed of 2 so game keeps flowing)
                if (car.speed > 2.5) car.speed -= car.friction;
            }

            // Steering (Responsive at speed, subtle drift angle)
            const turnSpeed = (car.speed / car.maxSpeed) * 6.5 + 1.5;
            if (keys.left) {
                car.vx = -turnSpeed;
                car.angle = -0.12;
            } else if (keys.right) {
                car.vx = turnSpeed;
                car.angle = 0.12;
            } else {
                car.vx *= 0.75;
                car.angle *= 0.75;
            }

            car.x += car.vx;

            // Road Boundary Collision
            if (car.x - car.width / 2 < roadLeft) {
                car.x = roadLeft + car.width / 2;
                car.speed *= 0.95; // Slow down on kerb scrape
            }
            if (car.x + car.width / 2 > roadRight) {
                car.x = roadRight - car.width / 2;
                car.speed *= 0.95;
            }

            roadOffset += car.speed;
            score += car.speed * 0.15;
        }

        function gameLoop() {
            if (!isRunning) return;

            ctx.clearRect(0, 0, width, height);
            updatePhysics();
            drawJaipurEnvironment();

            // Draw Skid Marks
            skidMarks.forEach((s, idx) => {
                s.y += car.speed;
                s.alpha -= 0.01;
                ctx.fillStyle = `rgba(15, 15, 15, ${s.alpha})`;
                ctx.fillRect(s.x, s.y, 5, 12);
                if (s.alpha <= 0) skidMarks.splice(idx, 1);
            });

            // Coins Update & Draw
            spawnCoins();
            coinList.forEach((c, idx) => {
                c.y += car.speed;
                c.angle += 0.1;

                // Draw Rotating Gold Coin
                ctx.save();
                ctx.translate(c.x, c.y);
                ctx.scale(Math.abs(Math.cos(c.angle)), 1);
                ctx.fillStyle = '#ffd700';
                ctx.beginPath();
                ctx.arc(0, 0, c.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = '#b8860b';
                ctx.lineWidth = 2;
                ctx.stroke();
                ctx.restore();

                // Coin Collection Check
                if (Math.hypot(car.x - c.x, car.y - c.y) < car.width / 2 + c.radius + 5) {
                    coins++;
                    score += 50;
                    playSound('coin');
                    coinList.splice(idx, 1);
                } else if (c.y > height + 50) {
                    coinList.splice(idx, 1);
                }
            });

            // Traffic Update & Draw
            spawnTraffic();
            traffic.forEach((t, idx) => {
                t.y += (car.speed - t.speed);
                drawCar(t.x, t.y, t.w, t.h, t.color, t.topColor, 0, false);

                // Overtake check
                if (!t.passed && t.y > car.y + car.height) {
                    t.passed = true;
                    overtakes++;
                    score += 25;
                }

                // Collision Detection (AABB with slight forgiveness)
                if (Math.abs(car.x - t.x) < (car.width + t.w) * 0.42 &&
                    Math.abs(car.y - t.y) < (car.height + t.h) * 0.42) {
                    gameOver();
                }

                if (t.y > height + 150 || t.y < -300) {
                    traffic.splice(idx, 1);
                }
            });

            // Draw Player Car (White Sports/SUV Jaipur style)
            drawCar(car.x, car.y, car.width, car.height, '#ffffff', '#e74c3c', car.angle, true);

            // Update UI
            document.getElementById('score').innerText = Math.floor(score);
            document.getElementById('coins').innerText = coins;
            document.getElementById('speed-val').innerText = Math.floor(car.speed * 11);
            updateMissionUI();

            requestAnimationFrame(gameLoop);
        }

        function gameOver() {
            isRunning = false;
            playSound('crash');
            const finalScore = Math.floor(score);
            if (finalScore > highScore) {
                highScore = finalScore;
                localStorage.setItem('jaipurHighScore', highScore);
                document.getElementById('highScore').innerText = highScore;
            }
            document.getElementById('final-stats').innerText = `आपका स्कोर: ${finalScore} | इकट्ठा सिक्के: ${coins}`;
            document.getElementById('gameover-screen').classList.remove('hidden');
        }

        // Keyboard Controls (PC Testing)
        window.addEventListener('keydown', e => {
            if (e.key === 'ArrowLeft' || e.key === 'a') keys.left = true;
            if (e.key === 'ArrowRight' || e.key === 'd') keys.right = true;
            if (e.key === 'ArrowUp' || e.key === 'w') keys.up = true;
            if (e.key === 'ArrowDown' || e.key === 's') keys.down = true;
        });
        window.addEventListener('keyup', e => {
            if (e.key === 'ArrowLeft' || e.key === 'a') keys.left = false;
            if (e.key === 'ArrowRight' || e.key === 'd') keys.right = false;
            if (e.key === 'ArrowUp' || e.key === 'w') keys.up = false;
            if (e.key === 'ArrowDown' || e.key === 's') keys.down = false;
        });

        // Mobile Touch Bindings
        function bindTouch(id, keyName) {
            const el = document.getElementById(id);
            el.addEventListener('touchstart', e => { e.preventDefault(); keys[keyName] = true; el.classList.add('active'); });
            el.addEventListener('touchend', e => { e.preventDefault(); keys[keyName] = false; el.classList.remove('active'); });
            el.addEventListener('mousedown', () => { keys[keyName] = true; el.classList.add('active'); });
            el.addEventListener('mouseup', () => { keys[keyName] = false; el.classList.remove('active'); });
        }
        bindTouch('btn-left', 'left');
        bindTouch('btn-right', 'right');
        bindTouch('btn-gas', 'up');
        bindTouch('btn-brake', 'down');
    </script>
</body>
</html>
